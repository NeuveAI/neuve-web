{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "turbo",
    ".storybook"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
