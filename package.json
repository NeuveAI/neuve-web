{
  "name": "neuve-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=web",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "storybook": "bun run --filter @workspace/ui storybook",
    "build-storybook": "bun run --filter @workspace/ui build-storybook",
    "test": "turbo test"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.3",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
